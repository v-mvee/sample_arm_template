		{
			"name": "[concat(parameters('workspaceName'), '/SQL script 3')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "CREATE TABLE [mtd].[config_table]\n(\n    source_file_name VARCHAR(200) NOT NULL,\n    target_schema_name VARCHAR(50) NOT NULL,\n    target_table_name VARCHAR(50) NOT NULL,\n    enable_flag BIT NOT NULL\n)\nGO\n\nINSERT INTO [mtd].[config_table] \n(\n    source_file_name, \n    target_schema_name, \n    target_table_name, \n    enable_flag\n)\nSELECT 'customers-1000.csv','adls','customers',1 UNION ALL\nSELECT 'leads-1000.csv','adls','leads',1 UNION ALL\nSELECT 'organizations-1000.csv','adls','organizations',1 UNION ALL\nSELECT 'people-1000.csv','adls','people',1;\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "synapsededipool",
						"poolName": "synapsededipool"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/SQL script 4')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "INSERT INTO [mtd].[config_table] \n(\n    source_file_name, \n    target_schema_name, \n    target_table_name, \n    enable_flag\n)\nSELECT 'customers-1000.csv','adls','customers',1 UNION ALL\nSELECT 'leads-1000.csv','adls','leads',1 UNION ALL\nSELECT 'organizations-1000.csv','adls','organizations',1 UNION ALL\nSELECT 'people-1000.csv','adls','people',1;\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "synapsededipool",
						"poolName": "synapsededipool"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/dummy_data_generator')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "-- Drop if exists\nIF OBJECT_ID('dbo.demo_table_5') IS NOT NULL\n    DROP TABLE dbo.demo_table_5;\nGO\n\n-- Create 10 million dummy rows\nCREATE TABLE dbo.demo_table_5\nWITH\n(\n    DISTRIBUTION = ROUND_ROBIN,\n    HEAP\n)\nAS\nWITH Numbers AS (\n    SELECT TOP (10000)\n        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n\n    FROM sys.all_objects\n)\nSELECT TOP (20000000)\n    ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS id,\n    ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) * 10 AS col_int,\n    (ROW_NUMBER() OVER (ORDER BY (SELECT NULL))) % 32767 AS col_smallint,\n    CAST(ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) * 1.1 AS DECIMAL(10,2)) AS col_dec,\n    CONCAT('name_', ROW_NUMBER() OVER (ORDER BY (SELECT NULL))) AS col_vc,\n    CASE WHEN (ROW_NUMBER() OVER (ORDER BY (SELECT NULL))) % 2 = 0 THEN 'Y' ELSE 'N' END AS col_flag,\n    '2000-01-01' AS col_date,\n    '2000-01-01T00:00:00' AS col_dt,\n    (ROW_NUMBER() OVER (ORDER BY (SELECT NULL))) * 100 AS col_bigint,\n    GETDATE() AS col_datetime\nFROM Numbers AS a\nCROSS JOIN Numbers AS b\nCROSS JOIN Numbers AS c;\nGO\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "synapsededipool",
						"poolName": "synapsededipool"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
